# 复制为 .env 后填写。此模板可入库，不含任何真实密钥。

# ---- 数据目录：只读引用，程序不会写入或修改其中任何文件 ----
# 填写本机存放 vectors.npy / meta.jsonl / chunks.jsonl / 校规源文件.json 的目录绝对路径。
# 数据文件不随仓库分发（体积与授权原因），clone 后需自行准备并在 .env 中指向它。
# 例：D:/data/campus-rules 或 /home/you/data/campus-rules
# 留空时程序默认取项目父目录，找不到数据会在加载阶段明确报错。
DATA_DIR=
# 运行时缓存目录，留空则使用项目根下的 var/
VAR_DIR=

# ---- LLM：生成答案 / 查询改写 / 生成后引用校验 ----
BASE_LLM_API_KEY=
BASE_LLM_API_URL=
BASE_LLM_API_MODEL=
# 端点后缀；若 BASE_LLM_API_URL 已是完整端点，此项留空
BASE_LLM_API_PATH=/chat/completions
# 推理模型（deepseek-v4.1-flash 等）思考链会占用 token 预算，太小会导致 content 为空
# 适配器在 finish_reason=length 时自动把预算翻倍重试一次
LLM_MAX_TOKENS=2400

# ---- Embedding：查询向量，必须与建库时使用的模型完全一致 ----
BASE_EMBEDDING_API_KEY=
BASE_EMBEDDING_API_URL=
BASE_EMBEDDING_API_MODEL=qwen3.7-text-embedding-flash
# openai    : OpenAI 兼容，POST {base}/embeddings，请求 {"model","input":[text]}
# dashscope : DashScope 原生（服务商文档 dashscope.TextEmbedding.call），
#             base 填 .../api/v1，代码自动拼 /services/embeddings/text-embedding/text-embedding，
#             请求 {"model","input":{"texts":[text]}}；此模式下忽略 BASE_EMBEDDING_API_PATH
EMBEDDING_STYLE=dashscope
# OpenAI 兼容端点用 /embeddings；服务商原生端点请填对应路径，或把完整 URL 填进上面并留空此项
BASE_EMBEDDING_API_PATH=/embeddings

# ---- Rerank：独立端点，后续自行填写 url / apikey / model ----
RERANK_API_URL=
RERANK_API_KEY=
RERANK_API_MODEL=
# 若 RERANK_API_URL 已填到具体服务路径，此项务必留空，否则会重复拼接导致 400
RERANK_API_PATH=
# cohere: {"model","query","documents","top_n"} -> {"results":[{"index","relevance_score"}]}
# dashscope: {"model","input":{"query","documents"},"parameters":{"top_n"}} -> {"output":{"results":[...]}}
RERANK_STYLE=dashscope
RERANK_TOP_N=8
RERANK_TIMEOUT=20

# ---- 检索与生成参数 ----
TOP_K_VECTOR=50
TOP_K_BM25=50
# 关闭向量召回时建议把 TOP_K_BM25 提到 100~150，让 rerank 从更大的候选池里精排
ENABLE_VECTOR_RECALL=true
RRF_K=60
FINAL_EVIDENCE=5
MIN_EVIDENCE_SCORE=0.0
# 问题—证据门槛：词面主判 + 语义补位
# 词面 = IDF 加权覆盖率（纯本地、零 API、不依赖重排分数尺度），达标即放行
# 语义 = 链路已有最高精排分，仅在词面不达标且分数来自 API rerank 时用于「救回」省略式追问
# 规则重排的分数尺度不同，语义补位会自动关闭并在结果里标注 semantic_source
# 任一置 0 即关闭对应项，便于消融对照
MIN_RELEVANCE_SCORE=0.30
MIN_SEMANTIC_SCORE=0.80
NEIGHBOR_WINDOW=1
# 按 doc_id（页）限额，防止单页刷屏；不是按整份文件
MAX_PER_DOC=2
MEMORY_TURNS=6
MAX_GENERATION_RETRY=1
LOG_LEVEL=INFO
